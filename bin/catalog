#!/usr/bin/env bash
set -euo pipefail

TAILWIND_VERSION="v4.3.3"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE_DIR="$ROOT/.tailwind"

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)  ASSET="tailwindcss-macos-arm64" ;;
  Darwin-x86_64) ASSET="tailwindcss-macos-x64" ;;
  Linux-aarch64) ASSET="tailwindcss-linux-arm64" ;;
  Linux-x86_64)  ASSET="tailwindcss-linux-x64" ;;
  *) echo "Unsupported platform: $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

BIN="$CACHE_DIR/tailwindcss-$TAILWIND_VERSION"
if [[ ! -x "$BIN" ]]; then
  mkdir -p "$CACHE_DIR"
  echo "Downloading Tailwind CSS $TAILWIND_VERSION ($ASSET)..." >&2
  curl -sfL "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/$ASSET" -o "$BIN"
  chmod +x "$BIN"
fi

"$BIN" -i "$ROOT/catalog/src.css" -o "$ROOT/catalog/catalog.css" --minify "$@"
